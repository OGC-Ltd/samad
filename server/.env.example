# Copy to .env and fill in. .env is gitignored: never commit the API key.
PARTNER_BASE_URL=https://intellifleetapi.intellifleet360.com/api
PARTNER_API_KEY=
# Signs the sign-in tokens: any long random string (openssl rand -hex 32).
JWT_SECRET=
# The default super admin (server/users.go): created on first start and kept a
# Platform Administrator with this password on every start. Everyone else is
# invited from the dashboard (Users). Hash a password with:
#   go run . hash-password '<password>'
# Keep the hash in single quotes: docker compose reads every $ in this file
# as a variable otherwise. (The server strips the quotes.)
ADMIN_EMAIL=
ADMIN_NAME=Samad Administrator
ADMIN_PASSWORD_HASH=''
PORT=8080
DATA_DIR=data
# Optional: serve the built dashboard from this server (e.g. ../build).
STATIC_DIR=
# Optional: a separately hosted dashboard's origin, for CORS.
ALLOW_ORIGIN=
# Partner polling cadence (the guide asks for 30-60 s).
POSITIONS_EVERY=30s
EVENTS_EVERY=30s
# Optional: the Fleet summary's AI brief (server/insight.go). Without a key the
# card shows the plain facts. The model sees counts, alarm types and plates only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
# Road routes with a traffic ETA, arrivals at a yard and the weather layer
# (server/google.go) use the dashboard's Google Maps key, with the Routes API
# and the Weather API enabled on it. Google refuses a key restricted to HTTP
# referrers for server calls: restrict it by API (and the box's IP), or set a
# separate server key in GOOGLE_ROUTING_API_KEY, which then wins.
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTING_API_KEY=

# Uploaded files (group organisation logos). With S3_BUCKET set they go to
# that private bucket (served back through this server, behind the sign-in);
# empty, they are kept in DATA_DIR/files. Credentials: the box's IAM role
# (preferred), or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here. The role
# needs s3:PutObject, s3:GetObject and s3:DeleteObject on the bucket's objects.
S3_BUCKET=samad-522505217087-af-south-1-an
S3_REGION=af-south-1
S3_PREFIX=
