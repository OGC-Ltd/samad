# Copy to .env and fill in. .env is gitignored: never commit the API key.
PARTNER_BASE_URL=https://intellifleetapi.intellifleet360.com/api
PARTNER_API_KEY=
# Signs the sign-in tokens: any long random string (openssl rand -hex 32).
JWT_SECRET=
# The one account. Hash a password with: go run . hash-password '<password>'
ADMIN_EMAIL=
ADMIN_NAME=Samad Administrator
ADMIN_PASSWORD_HASH=
PORT=8080
DATA_DIR=data
# Optional: serve the built dashboard from this server (e.g. ../build).
STATIC_DIR=
# Optional: a separately hosted dashboard's origin, for CORS.
ALLOW_ORIGIN=
# Partner polling cadence (the guide asks for 30-60 s).
POSITIONS_EVERY=30s
EVENTS_EVERY=30s
