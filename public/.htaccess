# Fleet dashboard on cPanel
# ─────────────────────────────────────────────────────────────────────────────
Options -Indexes
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Pass the Authorization header through to PHP (stripped on CGI/FPM hosts)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# No compression on the API relay — it would hold back the live stream
SetEnvIf Request_URI "^/api/" no-gzip=1 dont-vary=1

# ── API → AWS fleet-server ──────────────────────────────────────────────────
# OPTION 1 (fastest, if your host has mod_proxy): uncomment the next line and
# comment out OPTION 2. Test: https://yourdomain/api/v1/bootstrap should give JSON.
# RewriteRule ^api/(.*)$ http://13.247.178.217/api/$1 [P,L,QSA]

# OPTION 2 (works on almost any cPanel): relay through api.php
RewriteRule ^api/(.*)$ api.php?__path=$1 [L,QSA]

# ── Single-page app: every other unknown path loads index.html ──────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Don't cache index.html (so new deploys show up); cache hashed assets for a year
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
